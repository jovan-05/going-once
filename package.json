  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env server.ts",
    "seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "spike:paypal": "tsx --env-file-if-exists=.env scripts/spike-paypal.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "predev": "node scripts/copy-kokoro.mjs",
    "prebuild": "node scripts/copy-kokoro.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
