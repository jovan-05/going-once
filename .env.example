# PayPal (sandbox only)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# DONATION (default) falls back to DIGITAL_GOODS automatically if PayPal refuses it
PAYPAL_ITEM_CATEGORY=DONATION
# Optional: a sandbox *personal* test account, shown on /demo so judges can approve a hold.
# Sandbox only (developer.paypal.com > Sandbox accounts). Never a real PayPal login.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# AI auctioneer (Groq). Leave AI_API_KEY empty to run from the built-in line bank.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=                    # default openai/gpt-oss-120b (Groq)

# Voice: Kokoro-82M runs in the stage's browser (no key). Pick the voice at /voices.
# If Kokoro can't load, the stage falls back to the browser's speechSynthesis.

# App
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/going-once.db
CLERK_KEY=                   # optional fixed clerk key for the seeded room (random if empty)
DEV_ORIGINS=                 # dev only: comma-separated LAN hosts allowed to load dev assets, e.g. 192.168.1.20
ALLOW_TEST_BIDDERS=          # dev only: 1 enables simulated-hold test bidders in demo rooms

# Cloud voice for the auctioneer (smallest.ai Lightning). Optional: without a key the
# stage uses Kokoro in its own browser. The key stays on the server.
SMALLEST_API_KEY=
SMALLEST_VOICE=              # default henry; pick one on /voices (saved per browser)
SMALLEST_MODEL=              # default lightning_v3.1_pro
SMALLEST_MAX_CHARS=          # default 100000 per server run (~$2 of the $10 free credit)
